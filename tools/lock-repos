#!/usr/bin/env python3
"""Generate a git-aggregator-compatible repos.lock.yaml from repos.yaml.

This tool is intentionally conservative:
- repos.yaml controls repository membership;
- existing locked revisions are preserved by default;
- new repositories are resolved to the current remote ref;
- removed repositories disappear from the lock file;
- refresh is explicit.
- refresh can target a whole aggregate path or one concrete merge ref.
- target is preserved from repos.yaml because it documents the upstream branch
  lineage and lets git-aggregator clone that branch before applying locked SHAs.

The generated lock remains executable by git-aggregator. It replaces moving refs
such as "17.0" with exact commit revisions. It intentionally does not add
fetch_all by default because large repositories such as Odoo become very slow
when every branch/ref is fetched. Add fetch_all manually only for exceptional
refs that cannot be fetched through the normal strategy, such as temporary PR
or fork refs that are not reachable from the target branch.

Generated comments such as "# locked-from: odoo 17.0" are metadata for this
tool. They are ignored by git-aggregator, but they let lock-repos preserve the
same source ref on later runs without refreshing it.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml


def is_hex_sha(value: str) -> bool:
    return len(value) >= 7 and all(char in "0123456789abcdefABCDEF" for char in value)


def load_yaml(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    data = yaml.safe_load(path.read_text(encoding="utf-8"))
    if data is None:
        return {}
    if not isinstance(data, dict):
        raise SystemExit(f"{path}: expected a YAML mapping")
    return data


def dump_yaml(path: Path, data: dict[str, Any]) -> None:
    header = (
        "# Generated by oci-odoo/tools/lock-repos. Do not edit manually.\n"
        "# Edit repos.yaml, then regenerate this file.\n\n"
    )
    path.write_text(header + dump_lock_body(data), encoding="utf-8")


def dump_lock_body(data: dict[str, Any]) -> str:
    lines: list[str] = []
    for dest, entry in data.items():
        lines.append(f"{dest}:")
        lines.append("  remotes:")
        for remote, url in entry["remotes"].items():
            lines.append(f"    {remote}: {url}")
        if "target" in entry:
            lines.append("  target:")
            lines.append(f"    {entry['target']}")
        lines.append("  merges:")
        for item in entry["merges"]:
            lines.append(f"  # locked-from: {item['remote']} {item['ref']}")
            lines.append(f"  - {item['remote']} {item['revision']}")
    return "\n".join(lines) + "\n"


def parse_remote_ref(value: str, *, context: str) -> tuple[str, str]:
    parts = value.split(None, 1)
    if len(parts) != 2:
        raise SystemExit(f"{context}: expected '<remote> <ref>', got {value!r}")
    return parts[0], parts[1]


def normalize_merges(entry: dict[str, Any], *, dest: str) -> list[tuple[str, str]]:
    merges = entry.get("merges")
    if not isinstance(merges, list) or not merges:
        raise SystemExit(f"{dest}: expected non-empty merges list")

    normalized: list[tuple[str, str]] = []
    for index, merge in enumerate(merges):
        context = f"{dest}: merges[{index}]"
        if isinstance(merge, str):
            normalized.append(parse_remote_ref(merge, context=context))
        elif isinstance(merge, dict):
            remote = merge.get("remote")
            ref = merge.get("ref")
            if not isinstance(remote, str) or not isinstance(ref, str):
                raise SystemExit(f"{context}: expected remote/ref strings")
            normalized.append((remote, ref))
        else:
            raise SystemExit(f"{context}: expected string or mapping")
    return normalized


def load_lock_metadata(path: Path) -> dict[str, list[dict[str, str]]]:
    """Read generated locked-from comments from an existing lock file."""
    if not path.exists():
        return {}

    metadata: dict[str, list[dict[str, str]]] = {}
    current_dest: str | None = None
    in_merges = False
    pending_source: tuple[str, str] | None = None

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.rstrip()
        if not line or line.lstrip().startswith("#"):
            stripped = line.strip()
            if in_merges and stripped.startswith("# locked-from: "):
                try:
                    pending_source = parse_remote_ref(
                        stripped.removeprefix("# locked-from: "),
                        context="locked-from comment",
                    )
                except SystemExit:
                    pending_source = None
            continue

        if not raw_line.startswith(" ") and line.endswith(":"):
            current_dest = line[:-1]
            in_merges = False
            pending_source = None
            continue

        stripped = line.strip()
        if current_dest and stripped == "merges:":
            in_merges = True
            pending_source = None
            continue
        if current_dest and in_merges and stripped.startswith("- "):
            value = stripped.removeprefix("- ").split("#", 1)[0].strip()
            try:
                remote, revision = parse_remote_ref(value, context="locked merge")
            except SystemExit:
                pending_source = None
                continue
            source_remote, source_ref = pending_source or (remote, "")
            metadata.setdefault(current_dest, []).append(
                {
                    "remote": source_remote,
                    "ref": source_ref,
                    "locked_remote": remote,
                    "revision": revision,
                }
            )
            pending_source = None

    return metadata


def locked_item_matches(item: dict[str, Any] | None, remote: str, ref: str, remotes: dict[str, str]) -> bool:
    if not item:
        return False
    if item.get("remote") != remote:
        return False
    if "revision" in item:
        return (
            item.get("ref") == ref
            and item.get("url") == remotes.get(remote)
            and isinstance(item.get("revision"), str)
        )
    locked_ref = item.get("ref")
    return isinstance(locked_ref, str) and is_hex_sha(locked_ref)


def find_locked_merge(
    locked_metadata: list[dict[str, str]],
    locked_merges: list[Any],
    *,
    remote: str,
    ref: str,
    remotes: dict[str, str],
    index: int,
) -> dict[str, Any] | None:
    for item in locked_metadata:
        if item.get("remote") == remote and item.get("ref") == ref and is_hex_sha(item.get("revision", "")):
            return {
                "remote": remote,
                "url": remotes[remote],
                "ref": ref,
                "revision": item["revision"],
            }

    # Compatibility fallback for old generated locks without locked-from
    # comments. Use positional matching only; never match an arbitrary same
    # remote SHA because one aggregated repo may contain several merges from
    # the same remote.
    if index < len(locked_merges):
        item = locked_merges[index]
        if isinstance(item, str):
            try:
                item_remote, item_ref = parse_remote_ref(item, context="existing lock merge")
            except SystemExit:
                item_remote, item_ref = "", ""
            item = {"remote": item_remote, "ref": item_ref}
        if isinstance(item, dict) and locked_item_matches(item, remote, ref, remotes):
            if "revision" in item:
                return item
            return {
                "remote": remote,
                "url": remotes[remote],
                "ref": ref,
                "revision": item["ref"],
            }

    for item in locked_merges:
        if isinstance(item, str):
            try:
                item_remote, item_ref = parse_remote_ref(item, context="existing lock merge")
            except SystemExit:
                continue
            item = {"remote": item_remote, "ref": item_ref}
        if (
            isinstance(item, dict)
            and "revision" in item
            and locked_item_matches(item, remote, ref, remotes)
        ):
            if "revision" in item:
                return item
    return None


def resolve_ref(url: str, ref: str) -> str:
    candidates = [ref]
    if not ref.startswith("refs/"):
        candidates.extend([f"refs/heads/{ref}", f"refs/tags/{ref}"])

    for candidate in candidates:
        proc = subprocess.run(
            ["git", "ls-remote", "--exit-code", url, candidate],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            first_line = proc.stdout.splitlines()[0]
            return first_line.split()[0]

    raise SystemExit(f"Could not resolve ref {ref!r} from {url}")


def lock_ref(
    *,
    remote: str,
    ref: str,
    remotes: dict[str, str],
    existing: dict[str, Any] | None,
    refresh: bool,
) -> dict[str, str]:
    url = remotes.get(remote)
    if not url:
        raise SystemExit(f"Remote {remote!r} not found in remotes")

    if not refresh and locked_item_matches(existing, remote, ref, remotes):
        assert existing is not None
        return {
            "remote": remote,
            "url": url,
            "ref": ref,
            "revision": existing["revision"],
        }

    return {
        "remote": remote,
        "url": url,
        "ref": ref,
        "revision": resolve_ref(url, ref),
    }


def build_lock(
    repos: dict[str, Any],
    existing_lock: dict[str, Any],
    existing_metadata: dict[str, list[dict[str, str]]],
    *,
    refresh_all: bool,
    refresh_paths: set[str],
    refresh_merges: set[tuple[str, str, str]],
) -> dict[str, Any]:
    output: dict[str, Any] = {}

    for dest, entry in repos.items():
        if not isinstance(entry, dict):
            raise SystemExit(f"{dest}: expected repository mapping")
        remotes = entry.get("remotes")
        if not isinstance(remotes, dict) or not remotes:
            raise SystemExit(f"{dest}: expected non-empty remotes mapping")
        if not all(isinstance(k, str) and isinstance(v, str) for k, v in remotes.items()):
            raise SystemExit(f"{dest}: remotes must be string -> string")

        merges = normalize_merges(entry, dest=dest)
        existing = existing_lock.get(dest)
        if not isinstance(existing, dict):
            existing = {}

        existing_merges = existing.get("merges")
        if not isinstance(existing_merges, list):
            existing_merges = []
        existing_locked_metadata = existing_metadata.get(dest, [])

        locked_merges = [
            lock_ref(
                remote=remote,
                ref=ref,
                remotes=remotes,
                existing=find_locked_merge(
                    existing_locked_metadata,
                    existing_merges,
                    remote=remote,
                    ref=ref,
                    remotes=remotes,
                    index=index,
                ),
                refresh=refresh_all or dest in refresh_paths or (dest, remote, ref) in refresh_merges,
            )
            for index, (remote, ref) in enumerate(merges)
        ]

        locked_entry: dict[str, Any] = {
            "remotes": remotes,
        }
        if "target" in entry:
            target = entry["target"]
            if not isinstance(target, str):
                raise SystemExit(f"{dest}: target must be a string")
            locked_entry["target"] = target
        locked_entry["merges"] = locked_merges

        output[dest] = locked_entry

    return output


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--repos",
        default="repos.yaml",
        type=Path,
        help="input repos.yaml path",
    )
    parser.add_argument(
        "--lock",
        default="repos.lock.yaml",
        type=Path,
        help="output repos.lock.yaml path",
    )
    parser.add_argument("--refresh", action="append", default=[], help="refresh one destination path, e.g. ./odoo")
    parser.add_argument(
        "--refresh-merge",
        nargs=3,
        action="append",
        metavar=("DEST", "REMOTE", "REF"),
        default=[],
        help="refresh one concrete merge ref, e.g. --refresh-merge ./odoo nuobit 17.0-hotfix",
    )
    parser.add_argument("--refresh-all", action="store_true", help="refresh every locked revision")
    args = parser.parse_args()

    repos = load_yaml(args.repos)
    existing_lock = load_yaml(args.lock)
    existing_metadata = load_lock_metadata(args.lock)
    locked = build_lock(
        repos,
        existing_lock,
        existing_metadata,
        refresh_all=args.refresh_all,
        refresh_paths=set(args.refresh),
        refresh_merges={tuple(item) for item in args.refresh_merge},
    )
    dump_yaml(args.lock, locked)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
