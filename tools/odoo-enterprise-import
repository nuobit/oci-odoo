"""Inspect or import an Odoo Enterprise source bundle into Git.

The command is dry-run by default. It validates the source bundle against the
exact Community source selected by repos.lock.yaml and reports the modules that
are not present in that Community source. With --apply, it writes those
Enterprise modules into a local private Enterprise Git worktree.

The import phase is deliberately separate from image builds:
- this tool handles source bundle acquisition/classification/import preparation;
- Dockerfile.source-build consumes only Git repositories pinned in
  repos.lock.yaml.
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import zipfile
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import yaml


IGNORED_DIRS = {".git", "__pycache__", ".mypy_cache", ".pytest_cache", ".ruff_cache"}
IGNORED_SUFFIXES = {".pyc", ".pyo"}
PROPRIETARY_LICENSES = {"OEEL-1", "OPL-1"}
PROPRIETARY_LICENSE_MARKERS = (
    "enterprise edition license",
    "proprietary",
)
SOURCE_BLOCK_START = "<!-- odoo-enterprise-source:start -->"
SOURCE_BLOCK_END = "<!-- odoo-enterprise-source:end -->"


@dataclass(frozen=True)
class ModuleInfo:
    name: str
    path: Path
    root: Path
    digest: str
    license: str | None


def isoformat_utc(timestamp: float | int | None) -> str | None:
    if timestamp is None:
        return None
    return (
        datetime.fromtimestamp(timestamp, timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z")
    )


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha256_tree(path: Path) -> str:
    digest = hashlib.sha256()
    files: list[Path] = []
    for item in path.rglob("*"):
        if item.is_dir():
            continue
        rel = item.relative_to(path)
        if any(part in IGNORED_DIRS for part in rel.parts):
            continue
        if item.suffix in IGNORED_SUFFIXES:
            continue
        files.append(item)

    for item in sorted(files, key=lambda value: value.relative_to(path).as_posix()):
        rel = item.relative_to(path).as_posix()
        digest.update(rel.encode("utf-8"))
        digest.update(b"\0")
        digest.update(item.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


def load_yaml(path: Path) -> dict[str, Any]:
    data = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise SystemExit(f"{path}: expected a YAML mapping")
    return data


def parse_remote_ref(value: str, *, context: str) -> tuple[str, str]:
    parts = value.split(None, 1)
    if len(parts) != 2:
        raise SystemExit(f"{context}: expected '<remote> <ref>', got {value!r}")
    return parts[0], parts[1]


def locked_community_revision(lock_path: Path, community_dest: str) -> str:
    lock = load_yaml(lock_path)
    entry = lock.get(community_dest)
    if not isinstance(entry, dict):
        raise SystemExit(f"{lock_path}: missing community destination {community_dest!r}")
    merges = entry.get("merges")
    if not isinstance(merges, list) or len(merges) != 1:
        raise SystemExit(f"{lock_path}: {community_dest}: expected exactly one locked merge")
    merge = merges[0]
    if not isinstance(merge, str):
        raise SystemExit(f"{lock_path}: {community_dest}: expected string merge")
    _remote, revision = parse_remote_ref(merge, context=f"{community_dest}: merge")
    return revision


def git_head(path: Path) -> str | None:
    try:
        result = subprocess.run(
            ["git", "-C", str(path), "rev-parse", "HEAD"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None
    return result.stdout.strip()


def git_commit_info(path: Path, revision: str | None) -> dict[str, Any] | None:
    if not revision:
        return None
    try:
        output = run_git(
            path,
            "show",
            "-s",
            "--format=%H%x09%ct%x09%cI%x09%s",
            revision,
            capture=True,
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None
    if not output:
        return None
    return parse_git_commit_line(output.splitlines()[0])


def parse_git_commit_line(line: str) -> dict[str, Any] | None:
    parts = line.split("\t", 3)
    if len(parts) != 4:
        return None
    sha, timestamp, date, subject = parts
    try:
        timestamp_int = int(timestamp)
    except ValueError:
        return None
    return {
        "sha": sha,
        "short_sha": sha[:12],
        "timestamp": timestamp_int,
        "date": date,
        "subject": subject,
    }


def git_log_for_paths_after(
    path: Path,
    rel_paths: list[str],
    *,
    after_timestamp: int,
    max_scan: int = 200,
) -> tuple[list[dict[str, Any]], bool]:
    if not rel_paths:
        return [], False
    try:
        output = run_git(
            path,
            "log",
            f"--max-count={max_scan}",
            "--format=%H%x09%ct%x09%cI%x09%s",
            "--",
            *rel_paths,
            capture=True,
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return [], False

    commits: list[dict[str, Any]] = []
    scanned = 0
    reached_before_timestamp = False
    for line in output.splitlines():
        info = parse_git_commit_line(line)
        if not info:
            continue
        scanned += 1
        if info["timestamp"] > after_timestamp:
            commits.append(info)
            continue
        reached_before_timestamp = True
        break
    return list(reversed(commits)), bool(output.splitlines()) and not reached_before_timestamp and scanned >= max_scan


def git_commit_parents(path: Path, commit: str) -> list[str]:
    try:
        output = run_git(path, "rev-list", "--parents", "-n", "1", commit, capture=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []
    parts = output.split()
    return parts[1:] if len(parts) > 1 else []


def git_blob_sha256(path: Path, revision: str, rel_path: str) -> str | None:
    result = subprocess.run(
        ["git", "-C", str(path), "show", f"{revision}:{rel_path}"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode != 0:
        return None
    return hashlib.sha256(result.stdout).hexdigest()


def run_git(path: Path, *args: str, capture: bool = False) -> str:
    result = subprocess.run(
        ["git", "-C", str(path), *args],
        check=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        text=True,
    )
    return result.stdout.strip() if capture and result.stdout else ""


def ensure_clean_git_worktree(path: Path) -> None:
    try:
        inside = run_git(path, "rev-parse", "--is-inside-work-tree", capture=True)
    except (FileNotFoundError, subprocess.CalledProcessError) as exc:
        raise SystemExit(f"--apply requires --current-src to be inside a Git worktree: {path}") from exc
    if inside != "true":
        raise SystemExit(f"--apply requires --current-src to be inside a Git worktree: {path}")

    status = run_git(path, "status", "--porcelain", capture=True)
    if status:
        raise SystemExit(f"--apply requires a clean Enterprise Git worktree:\n{status}")


def module_manifest_path(path: Path) -> Path | None:
    for filename in ("__manifest__.py", "__openerp__.py"):
        manifest_path = path / filename
        if manifest_path.is_file():
            return manifest_path
    return None


def is_module_dir(path: Path) -> bool:
    return module_manifest_path(path) is not None


def manifest_license(path: Path) -> str | None:
    manifest_path = module_manifest_path(path)
    if manifest_path is None:
        return None
    try:
        data = ast.literal_eval(manifest_path.read_text(encoding="utf-8"))
    except (OSError, SyntaxError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    license_value = data.get("license")
    if not isinstance(license_value, str):
        return None
    return license_value.strip() or None


def is_proprietary_license(license_value: str | None) -> bool:
    if license_value is None:
        return False
    normalized = license_value.strip()
    if normalized in PROPRIETARY_LICENSES:
        return True
    lowered = normalized.lower()
    return any(marker in lowered for marker in PROPRIETARY_LICENSE_MARKERS)


def source_root(path: Path) -> Path:
    """Return the likely source root from an extracted source bundle directory."""
    candidates = [path]
    children = [child for child in path.iterdir() if child.is_dir()] if path.is_dir() else []
    if len(children) == 1:
        candidates.append(children[0])

    for candidate in candidates:
        if (candidate / "odoo" / "addons").is_dir() or (candidate / "addons").is_dir():
            return candidate
    return path


def addon_roots(source: Path) -> list[Path]:
    candidates = [
        source / "odoo" / "addons",
        source / "addons",
        source,
    ]
    roots: list[Path] = []
    for candidate in candidates:
        if not candidate.is_dir():
            continue
        if candidate == source and not any(is_module_dir(child) for child in candidate.iterdir() if child.is_dir()):
            continue
        roots.append(candidate)
    return roots


def collect_modules(source: Path) -> dict[str, ModuleInfo]:
    modules: dict[str, ModuleInfo] = {}
    duplicate_names: dict[str, list[Path]] = {}

    for root in addon_roots(source):
        for child in sorted(root.iterdir()):
            if not child.is_dir() or child.name in IGNORED_DIRS:
                continue
            if not is_module_dir(child):
                continue
            digest = sha256_tree(child)
            if child.name in modules:
                duplicate_names.setdefault(child.name, [modules[child.name].path]).append(child)
                continue
            modules[child.name] = ModuleInfo(
                name=child.name,
                path=child,
                root=root,
                digest=digest,
                license=manifest_license(child),
            )

    if duplicate_names:
        details = "\n".join(
            f"  {name}: {', '.join(str(path) for path in paths)}"
            for name, paths in sorted(duplicate_names.items())
        )
        raise SystemExit(f"Duplicate module names found in {source}:\n{details}")
    return modules


def collect_module_files(path: Path) -> dict[str, Path]:
    files: dict[str, Path] = {}
    for item in path.rglob("*"):
        if item.is_dir():
            continue
        rel = item.relative_to(path)
        if any(part in IGNORED_DIRS for part in rel.parts):
            continue
        if item.suffix in IGNORED_SUFFIXES:
            continue
        files[rel.as_posix()] = item
    return files


def build_drift_file_details(download_module: ModuleInfo, community_module: ModuleInfo) -> list[dict[str, Any]]:
    download_files = collect_module_files(download_module.path)
    community_files = collect_module_files(community_module.path)
    drift_files: list[dict[str, Any]] = []
    for rel_path in sorted(set(download_files) | set(community_files)):
        download_file = download_files.get(rel_path)
        community_file = community_files.get(rel_path)
        download_digest = sha256_file(download_file) if download_file else None
        community_digest = sha256_file(community_file) if community_file else None
        if download_digest == community_digest:
            continue
        if download_file and community_file:
            status = "modified"
        elif download_file:
            status = "source_bundle_only"
        else:
            status = "community_only"
        mtime = int(download_file.stat().st_mtime) if download_file else None
        drift_files.append(
            {
                "path": rel_path,
                "status": status,
                "source_bundle_sha256": download_digest,
                "community_sha256": community_digest,
                "source_bundle_mtime": isoformat_utc(mtime),
                "source_bundle_mtime_timestamp": mtime,
            }
        )
    return drift_files


def module_git_path(community_src: Path, community_module: ModuleInfo, module_relative_path: str) -> str:
    return (community_module.path.relative_to(community_src) / module_relative_path).as_posix()


def source_bundle_matches_git_revision(
    *,
    community_src: Path,
    community_module: ModuleInfo,
    drift_files: list[dict[str, Any]],
    revision: str,
) -> bool:
    for drift_file in drift_files:
        rel_path = module_git_path(community_src, community_module, drift_file["path"])
        git_digest = git_blob_sha256(community_src, revision, rel_path)
        if drift_file["source_bundle_sha256"] != git_digest:
            return False
    return True


def build_drift_details(
    *,
    download_modules: dict[str, ModuleInfo],
    community_modules: dict[str, ModuleInfo],
    drift_names: list[str],
    community_src: Path,
    community_revision: str,
    community_head: str | None,
) -> dict[str, Any]:
    details: dict[str, Any] = {}
    has_git_context = community_head is not None
    current_info = git_commit_info(community_src, community_head or community_revision) if has_git_context else None

    for name in sorted(drift_names):
        download_module = download_modules[name]
        community_module = community_modules[name]
        drift_files = build_drift_file_details(download_module, community_module)
        source_bundle_timestamps = [
            item["source_bundle_mtime_timestamp"]
            for item in drift_files
            if item["source_bundle_mtime_timestamp"] is not None
        ]
        source_bundle_latest_timestamp = max(source_bundle_timestamps) if source_bundle_timestamps else None
        source_bundle_latest_mtime = isoformat_utc(source_bundle_latest_timestamp)
        module_detail: dict[str, Any] = {
            "diagnosis": "limited_context",
            "diagnosis_reason": "Community source has no Git history available for local commit analysis.",
            "source_bundle_latest_mtime": source_bundle_latest_mtime,
            "source_bundle_latest_mtime_timestamp": source_bundle_latest_timestamp,
            "community_current": current_info,
            "drifted_files": drift_files,
            "commits_after_source_bundle_timestamp": [],
            "commits_after_source_bundle_timestamp_truncated": False,
            "matching_ancestor_commit": None,
            "matching_parent_of_commit": None,
        }

        if not has_git_context:
            details[name] = module_detail
            continue
        if source_bundle_latest_timestamp is None:
            module_detail["diagnosis_reason"] = "No source bundle file timestamp was available for drift diagnosis."
            details[name] = module_detail
            continue

        rel_paths = [
            module_git_path(community_src, community_module, drift_file["path"])
            for drift_file in drift_files
        ]
        commits_after, truncated = git_log_for_paths_after(
            community_src,
            rel_paths,
            after_timestamp=source_bundle_latest_timestamp,
        )
        module_detail["commits_after_source_bundle_timestamp"] = commits_after
        module_detail["commits_after_source_bundle_timestamp_truncated"] = truncated

        for commit in commits_after:
            for parent in git_commit_parents(community_src, commit["sha"]):
                if source_bundle_matches_git_revision(
                    community_src=community_src,
                    community_module=community_module,
                    drift_files=drift_files,
                    revision=parent,
                ):
                    module_detail["diagnosis"] = "source_bundle_lag_confirmed"
                    module_detail["diagnosis_reason"] = (
                        "The source bundle copy matches the Community state immediately before "
                        "a newer Community commit touching the drifted file(s)."
                    )
                    module_detail["matching_ancestor_commit"] = git_commit_info(community_src, parent) or {
                        "sha": parent,
                        "short_sha": parent[:12],
                    }
                    module_detail["matching_parent_of_commit"] = commit
                    break
            if module_detail["diagnosis"] == "source_bundle_lag_confirmed":
                break

        if module_detail["diagnosis"] != "source_bundle_lag_confirmed":
            module_detail["diagnosis"] = "unexplained_drift"
            module_detail["diagnosis_reason"] = (
                "The source bundle copy did not match a parent of the Community commits "
                "found after the source bundle timestamp."
            )
        details[name] = module_detail
    return details


def safe_relative_to(destination: Path, member_name: str) -> None:
    destination_resolved = destination.resolve()
    member_path = destination / member_name
    try:
        member_path.resolve().relative_to(destination_resolved)
    except ValueError as exc:
        raise SystemExit(f"Unsafe source bundle member path: {member_name!r}") from exc


def extract_source_bundle(source_bundle_path: Path, destination: Path) -> Path:
    if zipfile.is_zipfile(source_bundle_path):
        with zipfile.ZipFile(source_bundle_path) as bundle:
            for member in bundle.infolist():
                safe_relative_to(destination, member.filename)
            bundle.extractall(destination)
        return source_root(destination)

    if tarfile.is_tarfile(source_bundle_path):
        with tarfile.open(source_bundle_path) as bundle:
            for member in bundle.getmembers():
                if member.issym() or member.islnk():
                    raise SystemExit(f"Refusing source bundle link member: {member.name!r}")
                safe_relative_to(destination, member.name)
            extract_tar_members(bundle, destination)
        return source_root(destination)

    raise SystemExit(f"Unsupported Enterprise source bundle format: {source_bundle_path}")


def source_bundle_kind(source_bundle_path: Path) -> str | None:
    if zipfile.is_zipfile(source_bundle_path):
        return "zip"
    if tarfile.is_tarfile(source_bundle_path):
        return "tar"
    return None


def source_bundle_extension(source_bundle_path: Path, source_bundle_type: str | None) -> str:
    name = source_bundle_path.name
    for suffix in (".tar.gz", ".tgz", ".tar.bz2", ".tbz2", ".tar.xz", ".txz", ".tar", ".zip"):
        if name.endswith(suffix):
            return suffix
    if source_bundle_type == "zip":
        return ".zip"
    if source_bundle_type == "tar":
        return ".tar"
    return "".join(source_bundle_path.suffixes)


def odoo_file_from_source_bundle(
    source_bundle_path: Path,
    source_bundle_type: str | None,
    download_src: Path,
) -> str:
    extension = source_bundle_extension(source_bundle_path, source_bundle_type)
    root_name = download_src.name
    if root_name.startswith("odoo-") and "+e." in root_name:
        return f"{root_name}{extension}"
    return source_bundle_path.name


def source_bundle_date(odoo_file: str, source_bundle_path: Path) -> str:
    match = re.search(r"\+e\.(\d{8})", odoo_file)
    if match:
        raw = match.group(1)
        return f"{raw[:4]}-{raw[4:6]}-{raw[6:]}"
    return datetime.fromtimestamp(source_bundle_path.stat().st_mtime, timezone.utc).date().isoformat()


def source_bundle_identity(
    *,
    source_bundle_path: Path,
    source_bundle_type: str | None,
    source_bundle_size: int,
    source_bundle_sha256: str,
    download_src: Path,
) -> dict[str, Any]:
    odoo_file = odoo_file_from_source_bundle(source_bundle_path, source_bundle_type, download_src)
    return {
        "odoo_file": odoo_file,
        "date": source_bundle_date(odoo_file, source_bundle_path),
        "size": source_bundle_size,
        "sha256": source_bundle_sha256,
    }


def extract_tar_members(bundle: tarfile.TarFile, destination: Path) -> None:
    try:
        bundle.extractall(destination, filter="data")
    except TypeError as exc:
        if "filter" not in str(exc):
            raise
        bundle.extractall(destination)


def write_report(path: Path, report: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def render_source_bundle_block(identity: dict[str, Any]) -> str:
    return "\n".join(
        [
            SOURCE_BLOCK_START,
            "Initial source bundle:",
            "",
            f"- Odoo file: `{identity['odoo_file']}`",
            f"- Date: `{identity['date']}`",
            f"- Size: `{identity['size']}` bytes",
            "- SHA-256:",
            f"  `{identity['sha256']}`",
            SOURCE_BLOCK_END,
        ]
    )


def replace_or_insert_source_bundle_block(readme_text: str, identity: dict[str, Any]) -> str:
    block = render_source_bundle_block(identity)
    if SOURCE_BLOCK_START in readme_text and SOURCE_BLOCK_END in readme_text:
        pattern = re.compile(
            rf"{re.escape(SOURCE_BLOCK_START)}.*?{re.escape(SOURCE_BLOCK_END)}",
            re.DOTALL,
        )
        return pattern.sub(block, readme_text, count=1)

    legacy_pattern = re.compile(
        r"Initial source bundle:\n\n"
        r"- Odoo file: `[^`]+`\n"
        r"- Date: `[^`]+`\n"
        r"- Size: `[^`]+` bytes\n"
        r"- SHA-256:\n"
        r"  `[^`]+`",
        re.DOTALL,
    )
    if legacy_pattern.search(readme_text):
        return legacy_pattern.sub(block, readme_text, count=1)

    anchor = "The detailed import report is kept as an external operation record"
    if anchor in readme_text:
        return readme_text.replace(anchor, f"{block}\n\n{anchor}", 1)
    return readme_text.rstrip() + "\n\n" + block + "\n"


def update_source_bundle_readme(current_src: Path, identity: dict[str, Any]) -> dict[str, Any] | None:
    readme_path = current_src / "README.md"
    existing = readme_path.read_text(encoding="utf-8") if readme_path.exists() else "# Odoo Enterprise Source\n"
    updated = replace_or_insert_source_bundle_block(existing, identity)
    if updated == existing:
        return None

    readme_path.write_text(updated.rstrip() + "\n", encoding="utf-8")
    sha = commit_path(
        current_src,
        Path("README.md"),
        "[DOC] README: update source bundle identity",
        "\n".join(
            [
                "Update the source bundle identity recorded for the private",
                "Odoo Enterprise source mirror.",
                "",
                f"Odoo file: {identity['odoo_file']}",
                f"Date: {identity['date']}",
                f"Size: {identity['size']} bytes",
                f"SHA-256: {identity['sha256']}",
            ]
        ),
    )
    return {
        "path": "README.md",
        "commit": sha,
        "odoo_file": identity["odoo_file"],
    }


def ensure_inside(root: Path, path: Path) -> None:
    try:
        path.resolve().relative_to(root.resolve())
    except ValueError as exc:
        raise SystemExit(f"Refusing to write outside current source: {path}") from exc


def replace_module_tree(source: Path, target: Path, current_src: Path) -> None:
    ensure_inside(current_src, target)
    if target.exists():
        if not target.is_dir():
            raise SystemExit(f"Refusing to replace non-directory module path: {target}")
        shutil.rmtree(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source, target)


def remove_module_tree(target: Path, current_src: Path) -> None:
    ensure_inside(current_src, target)
    if not target.exists():
        return
    if not target.is_dir():
        raise SystemExit(f"Refusing to remove non-directory module path: {target}")
    shutil.rmtree(target)


def module_relative_path(module: ModuleInfo, source: Path) -> str:
    try:
        return module.path.relative_to(source).as_posix()
    except ValueError:
        return module.path.as_posix()


def build_import_plan(
    *,
    download_modules: dict[str, ModuleInfo],
    current_modules: dict[str, ModuleInfo],
    enterprise_names: list[str],
    download_root_path: Path,
    current_root_path: Path | None,
) -> dict[str, Any]:
    download_names = set(enterprise_names)
    current_names = set(current_modules)
    add = sorted(download_names - current_names)
    common = sorted(download_names & current_names)
    update = sorted(name for name in common if download_modules[name].digest != current_modules[name].digest)
    unchanged = sorted(name for name in common if download_modules[name].digest == current_modules[name].digest)
    remove = sorted(current_names - download_names)

    action_details: dict[str, dict[str, Any]] = {}
    for name in add + update + unchanged:
        download_module = download_modules[name]
        current_module = current_modules.get(name)
        action = "add"
        if name in update:
            action = "update"
        elif name in unchanged:
            action = "unchanged"
        action_details[name] = {
            "action": action,
            "classification": "enterprise",
            "download_digest": download_module.digest,
            "current_digest": current_module.digest if current_module else None,
            "download_license": download_module.license,
            "current_license": current_module.license if current_module else None,
            "download_relative_path": module_relative_path(download_module, download_root_path),
            "current_relative_path": (
                module_relative_path(current_module, current_root_path)
                if current_module and current_root_path
                else None
            ),
        }

    for name in remove:
        current_module = current_modules[name]
        action_details[name] = {
            "action": "remove",
            "classification": "current_only",
            "download_digest": None,
            "current_digest": current_module.digest,
            "download_license": None,
            "current_license": current_module.license,
            "download_relative_path": None,
            "current_relative_path": module_relative_path(current_module, current_root_path)
            if current_root_path
            else None,
        }

    return {
        "current_source": "<current-src>" if current_root_path else None,
        "summary": {
            "add": len(add),
            "update": len(update),
            "remove": len(remove),
            "unchanged": len(unchanged),
            "review_required": len(remove),
        },
        "actions": {
            "add": add,
            "update": update,
            "remove": remove,
            "unchanged": unchanged,
        },
        "review_required_modules": remove,
        "action_details": action_details,
    }


def build_human_summary(report: dict[str, Any]) -> dict[str, Any]:
    counts = report["counts"]
    plan = report["import_plan"]["summary"]
    removal_modules = report["import_plan"]["actions"]["remove"]
    warnings: list[str] = []
    if counts["missing_community_modules"]:
        warnings.append(
            f"{counts['missing_community_modules']} pinned official Community module(s) are missing from the download"
        )
    if counts["enterprise_drift_modules"]:
        warnings.append(
            f"{counts['enterprise_drift_modules']} Enterprise source bundle embedded-Community module(s) drift byte-for-byte"
        )
    if plan["remove"]:
        warnings.append(f"{plan['remove']} current module(s) are planned as removal")
    if report["community_worktree_head"] and report["community_worktree_head"] != report["community_lock_revision"]:
        warnings.append("Community checkout HEAD differs from repos.lock.yaml revision")

    return {
        "mode": report["mode"],
        "community_modules": counts["community_modules"],
        "download_modules": counts["download_modules"],
        "current_modules": counts["current_modules"],
        "enterprise_modules": counts["enterprise_modules"],
        "enterprise_drift_modules": report["enterprise_drift_modules"],
        "plan": {
            "add": plan["add"],
            "update": plan["update"],
            "remove": plan["remove"],
            "unchanged": plan["unchanged"],
            "review_required": plan["review_required"],
        },
        "review_removal_modules": removal_modules,
        "warnings": warnings,
    }


def print_human_summary(summary: dict[str, Any]) -> None:
    plan = summary["plan"]
    title = (
        "Enterprise import apply summary"
        if summary["mode"] == "apply"
        else "Enterprise import dry-run summary"
    )
    print(title)
    print("-" * len(title))
    print(f"Community modules:            {summary['community_modules']}")
    print(f"Downloaded modules:           {summary['download_modules']}")
    print(f"Current modules:              {summary['current_modules']}")
    print(f"Enterprise modules:           {summary['enterprise_modules']}")
    print(
        "Plan: add {add}, update {update}, remove {remove}, unchanged {unchanged}, review {review_required}".format(
            **plan
        )
    )
    if summary["warnings"]:
        print("Warnings:")
        for warning in summary["warnings"]:
            print(f"  - {warning}")
    else:
        print("Warnings: none")
    if summary["review_removal_modules"]:
        print("Current modules planned as removal and needing review:")
        for name in summary["review_removal_modules"]:
            print(f"  - {name}")
    print()


def format_modules_for_error(module_names: list[str], *, limit: int = 50) -> str:
    visible = module_names[:limit]
    suffix = "" if len(module_names) <= limit else f", ... ({len(module_names) - limit} more)"
    return ", ".join(visible) + suffix


def format_commit_for_error(commit: dict[str, Any] | None) -> str:
    if not commit:
        return "not available"
    short_sha = commit.get("short_sha") or str(commit.get("sha", ""))[:12]
    date = commit.get("date", "date not available")
    subject = commit.get("subject")
    if subject:
        return f"{short_sha} {date}\n    {subject}"
    return f"{short_sha} {date}"


def format_drift_details_for_error(drift_details: dict[str, Any]) -> str:
    if not drift_details:
        return ""

    lines = [
        "",
        "Drift diagnosis",
        "---------------",
    ]
    for module_name, detail in sorted(drift_details.items()):
        lines.extend(
            [
                "",
                f"Affected module: {module_name}",
                f"  diagnosis: {detail['diagnosis']}",
                f"  reason: {detail['diagnosis_reason']}",
                "  source bundle embedded Community copy:",
                f"    latest drifted file timestamp: {detail['source_bundle_latest_mtime'] or 'not available'}",
                "  pinned official Community:",
                f"    current commit: {format_commit_for_error(detail.get('community_current'))}",
            ]
        )

        commits_after = detail.get("commits_after_source_bundle_timestamp") or []
        if commits_after:
            lines.append("  Community commits after source bundle timestamp touching drifted files:")
            for commit in commits_after:
                lines.append(f"    - {format_commit_for_error(commit)}")
            if detail.get("commits_after_source_bundle_timestamp_truncated"):
                lines.append("    - ... additional commits omitted by the diagnostic safety limit")
        else:
            lines.append("  Community commits after source bundle timestamp touching drifted files: none found")

        if detail.get("matching_ancestor_commit") and detail.get("matching_parent_of_commit"):
            lines.extend(
                [
                    "  source bundle copy matches:",
                    (
                        "    parent of "
                        f"{detail['matching_parent_of_commit']['short_sha']}: "
                        f"{detail['matching_ancestor_commit']['short_sha']}"
                    ),
                ]
            )

        lines.append("  drifted files:")
        for drift_file in detail["drifted_files"]:
            lines.append(f"    - {drift_file['path']} ({drift_file['status']})")

        if detail["diagnosis"] == "source_bundle_lag_confirmed":
            lines.extend(
                [
                    "  conclusion:",
                    "    This looks like the Enterprise source bundle was generated before a newer",
                    "    Community fix was merged. Community remains authoritative. The",
                    "    drifted module will not be imported into the Enterprise mirror.",
                ]
            )
        elif detail["diagnosis"] == "limited_context":
            lines.extend(
                [
                    "  conclusion:",
                    "    Automatic Git history diagnosis could not be performed. Review the",
                    "    drift manually before using --allow-drift.",
                ]
            )
        else:
            lines.extend(
                [
                    "  conclusion:",
                    "    The drift was not explained by a recent Community ancestor match.",
                    "    Review manually before using --allow-drift.",
                ]
            )

    return "\n".join(lines)


def format_drift_error(report: dict[str, Any]) -> str:
    affected = format_modules_for_error(sorted(report["enterprise_drift_modules"]))
    return "\n".join(
        [
            "ERROR: Enterprise source bundle drift detected.",
            "",
            "The source bundle embeds Community module copies that differ from the freshly",
            "pinned official Odoo Community source.",
            "",
            f"Affected modules: {affected}",
            format_drift_details_for_error(report.get("enterprise_drift_details", {})),
            "",
            "Rerun with --allow-drift if you accept this reviewed drift.",
        ]
    )


def commit_message_for(action: str, module: str, date: str) -> str:
    if action == "add":
        return f"[ADD] {module}: import from Odoo Enterprise {date}"
    if action == "update":
        return f"[IMP] {module}: update from Odoo Enterprise {date}"
    if action == "remove":
        return f"[REM] {module}: remove from Odoo Enterprise {date}"
    raise ValueError(f"Unsupported commit action: {action}")


def commit_body_for(report: dict[str, Any], detail: dict[str, Any]) -> str:
    lines = [
        "Odoo Enterprise import.",
        "",
        f"Generated at: {report['generated_at']}",
        f"Source bundle sha256: {report['source_bundle_sha256'] or 'not available'}",
        f"Community commit: {report['community_lock_revision']}",
        f"Download digest: {detail['download_digest'] or 'not available'}",
        f"Previous digest: {detail['current_digest'] or 'not available'}",
        f"Manifest license: {detail['download_license'] or detail['current_license'] or 'not declared'}",
    ]
    return "\n".join(lines)


def commit_path(current_src: Path, relative_path: Path, message: str, body: str) -> str:
    run_git(current_src, "add", "-A", "--", relative_path.as_posix())
    run_git(current_src, "commit", "-q", "-m", message, "-m", body)
    return run_git(current_src, "rev-parse", "HEAD", capture=True)


def apply_import_plan(
    *,
    args: argparse.Namespace,
    report: dict[str, Any],
    download_modules: dict[str, ModuleInfo],
    current_modules: dict[str, ModuleInfo],
    current_src: Path,
) -> dict[str, Any]:
    if not args.current_src:
        raise SystemExit("--apply requires --current-src")
    if report["import_plan"]["actions"]["remove"] and not args.apply_removals:
        removals = ", ".join(report["import_plan"]["actions"]["remove"])
        raise SystemExit(
            "--apply found removals that require explicit review. "
            f"Rerun with --apply-removals to remove: {removals}"
        )

    ensure_clean_git_worktree(current_src)
    applied: list[dict[str, Any]] = []
    import_date = datetime.now(timezone.utc).date().isoformat()
    action_order = ("add", "update", "remove")

    for action in action_order:
        for module_name in report["import_plan"]["actions"][action]:
            detail = report["import_plan"]["action_details"][module_name]
            if action in {"add", "update"}:
                download_module = download_modules[module_name]
                target = current_modules[module_name].path if module_name in current_modules else current_src / module_name
                replace_module_tree(download_module.path, target, current_src)
            else:
                target = current_modules[module_name].path
                remove_module_tree(target, current_src)

            relative_target = target.relative_to(current_src)
            sha = commit_path(
                current_src,
                relative_target,
                commit_message_for(action, module_name, import_date),
                commit_body_for(report, detail),
            )
            applied.append(
                {
                    "module": module_name,
                    "action": action,
                    "commit": sha,
                    "path": relative_target.as_posix(),
                }
            )
            current_modules = collect_modules(current_src)

    report["apply_result"] = {
        "commits": applied,
    }
    if report.get("source_bundle_identity"):
        report["apply_result"]["readme_commit"] = update_source_bundle_readme(
            current_src,
            report["source_bundle_identity"],
        )
    ensure_clean_git_worktree(current_src)
    return report["apply_result"]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Inspect or apply an Odoo Enterprise source bundle/folder import against pinned official Community source.",
    )
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--source-bundle", dest="source_bundle_path", type=Path, help="Enterprise source bundle")
    source.add_argument(
        "--download-src",
        type=Path,
        help="Already extracted Odoo Enterprise download root",
    )
    parser.add_argument("--community-src", type=Path, required=True, help="Local Odoo Community checkout/root")
    parser.add_argument(
        "--repos-lock",
        type=Path,
        required=True,
        help="repos.lock.yaml that contains the Community commit used by this deployment",
    )
    parser.add_argument(
        "--community-dest",
        default="./odoo",
        help="Destination key in repos.lock.yaml for Odoo Community (default: ./odoo)",
    )
    parser.add_argument("--report-json", type=Path, help="Write a machine-readable import report")
    parser.add_argument(
        "--json-only",
        action="store_true",
        help="Print only JSON to stdout, without the human summary",
    )
    parser.add_argument(
        "--current-src",
        type=Path,
        help="Current private/internal source root to compare against for an add/update/remove plan",
    )
    parser.add_argument(
        "--allow-community-head-mismatch",
        action="store_true",
        help="Report but do not fail when Community checkout HEAD differs from repos.lock.yaml",
    )
    parser.add_argument(
        "--allow-drift",
        action="store_true",
        help=(
            "Allow import to continue when the Enterprise source bundle embeds Community module copies "
            "that differ from the freshly pinned official Odoo Community source"
        ),
    )
    parser.add_argument(
        "--apply",
        action="store_true",
        help="Apply the import plan to --current-src and create Git commits",
    )
    parser.add_argument(
        "--apply-removals",
        action="store_true",
        help="Allow --apply to remove current Enterprise modules absent from the new import plan",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    lock_path = args.repos_lock.resolve()
    community_src = source_root(args.community_src.resolve())

    if not lock_path.is_file():
        raise SystemExit(f"repos lock not found: {lock_path}")
    if not community_src.is_dir():
        raise SystemExit(f"community source not found: {community_src}")

    community_revision = locked_community_revision(lock_path, args.community_dest)
    community_head = git_head(community_src)
    current_src = None
    source_bundle_sha256 = None
    source_bundle_size = None
    source_bundle_type = None
    source_bundle_identity_data = None

    if args.current_src:
        current_src = source_root(args.current_src.resolve())
        if not current_src.is_dir():
            raise SystemExit(f"current source not found: {current_src}")

    with tempfile.TemporaryDirectory(prefix="odoo-enterprise-import-") as tmp_name:
        if args.source_bundle_path:
            source_bundle_path = args.source_bundle_path.resolve()
            if not source_bundle_path.is_file():
                raise SystemExit(f"source bundle not found: {source_bundle_path}")
            source_bundle_type = source_bundle_kind(source_bundle_path)
            if not source_bundle_type:
                raise SystemExit(f"unsupported Enterprise source bundle format: {source_bundle_path}")
            source_bundle_sha256 = sha256_file(source_bundle_path)
            source_bundle_size = source_bundle_path.stat().st_size
            download_src = extract_source_bundle(source_bundle_path, Path(tmp_name))
            source_bundle_identity_data = source_bundle_identity(
                source_bundle_path=source_bundle_path,
                source_bundle_type=source_bundle_type,
                source_bundle_size=source_bundle_size,
                source_bundle_sha256=source_bundle_sha256,
                download_src=download_src,
            )
        else:
            download_src = source_root(args.download_src.resolve())

        if not download_src.is_dir():
            raise SystemExit(f"download source not found: {download_src}")

        community_modules = collect_modules(community_src)
        download_modules = collect_modules(download_src)
        if not community_modules:
            raise SystemExit(f"No Community modules found in {community_src}")
        if not download_modules:
            raise SystemExit(f"No downloaded modules found in {download_src}")

        community_names = set(community_modules)
        download_names = set(download_modules)
        missing_community = sorted(community_names - download_names)
        enterprise_modules = sorted(download_names - community_names)
        matched_community = sorted(community_names & download_names)
        enterprise_drift = [
            name
            for name in matched_community
            if community_modules[name].digest != download_modules[name].digest
        ]
        enterprise_drift_details = build_drift_details(
            download_modules=download_modules,
            community_modules=community_modules,
            drift_names=enterprise_drift,
            community_src=community_src,
            community_revision=community_revision,
            community_head=community_head,
        )
        enterprise_details = {
            name: {
                "license": download_modules[name].license,
                "license_is_proprietary": is_proprietary_license(download_modules[name].license),
                "relative_path": download_modules[name].path.relative_to(download_src).as_posix(),
            }
            for name in enterprise_modules
        }
        for details in enterprise_details.values():
            details["effective_classification"] = "enterprise_by_community_difference"
        current_modules = collect_modules(current_src) if current_src else {}
        import_plan = build_import_plan(
            download_modules=download_modules,
            current_modules=current_modules,
            enterprise_names=enterprise_modules,
            download_root_path=download_src,
            current_root_path=current_src,
        )
        recommendations: list[str] = []
        if missing_community:
            recommendations.extend(
                [
                    "Ensure the Enterprise source bundle was freshly downloaded.",
                    "Run lock-repos --refresh ./odoo if the local Community lock may be stale, then retry.",
                    "Ensure --community-src was materialized from the same repos.lock.yaml being checked.",
                ]
            )
        if enterprise_drift:
            recommendations.extend(
                [
                    "Refresh Odoo Community from the official Odoo GitHub repository and retry.",
                    "If Enterprise source bundle drift remains after refresh, review the listed modules and rerun with --allow-drift.",
                ]
            )
        if enterprise_modules:
            recommendations.append(
                "All downloaded modules absent from refreshed Community are treated as Enterprise modules."
            )
        if import_plan["actions"]["remove"]:
            recommendations.append(
                "Current Enterprise-only modules are planned as removals, but each removal needs review before apply."
            )

        report = {
            "generated_at": datetime.now(timezone.utc).isoformat(),
            "mode": "apply" if args.apply else "dry-run",
            "source_bundle_sha256": source_bundle_sha256,
            "source_bundle_size": source_bundle_size,
            "source_bundle_type": source_bundle_type,
            "source_bundle_identity": source_bundle_identity_data,
            "download_source": "<download-src>",
            "current_source": "<current-src>" if current_src else None,
            "community_source": "<community-src>",
            "community_dest": args.community_dest,
            "community_lock_revision": community_revision,
            "community_worktree_head": community_head,
            "community_source_used_as_import_reference": True,
            "counts": {
                "community_modules": len(community_modules),
                "download_modules": len(download_modules),
                "matched_community_modules": len(matched_community),
                "missing_community_modules": len(missing_community),
                "enterprise_drift_modules": len(enterprise_drift),
                "drifted_community_modules": len(enterprise_drift),
                "enterprise_modules": len(enterprise_modules),
                "current_modules": len(current_modules),
            },
            "missing_community_modules": missing_community,
            "enterprise_drift_modules": sorted(enterprise_drift),
            "drifted_community_modules": sorted(enterprise_drift),
            "enterprise_drift_details": enterprise_drift_details,
            "enterprise_modules": enterprise_modules,
            "enterprise_details": enterprise_details,
            "import_plan": import_plan,
            "recommendations": recommendations,
        }
        report["human_summary"] = build_human_summary(report)

        if args.apply:
            if missing_community:
                print(
                    "ERROR: Enterprise download is not an exhaustive superset of the pinned official Community source. "
                    "Refresh the Enterprise source bundle and/or run lock-repos --refresh ./odoo, then retry.",
                    file=sys.stderr,
                )
                return 2
            if enterprise_drift and not args.allow_drift:
                print(format_drift_error(report), file=sys.stderr)
                return 3
            if community_head and community_head != community_revision and not args.allow_community_head_mismatch:
                print(
                    "ERROR: Community worktree HEAD differs from repos.lock.yaml revision. "
                    "Use --allow-community-head-mismatch only after review.",
                    file=sys.stderr,
                )
                return 4
            apply_import_plan(
                args=args,
                report=report,
                download_modules=download_modules,
                current_modules=current_modules,
                current_src=current_src,
            )

        if args.report_json:
            write_report(args.report_json, report)

        if not args.json_only:
            print_human_summary(report["human_summary"])
        print(json.dumps(report, indent=2, sort_keys=True))

        if missing_community:
            print(
                "ERROR: Enterprise download is not an exhaustive superset of the pinned official Community source. "
                "Refresh the Enterprise source bundle and/or run lock-repos --refresh ./odoo, then retry.",
                file=sys.stderr,
            )
            return 2
        if enterprise_drift and not args.allow_drift:
            print(format_drift_error(report), file=sys.stderr)
            return 3
        if enterprise_drift:
            print(
                "WARNING: Enterprise source bundle drift accepted with --allow-drift.",
                file=sys.stderr,
            )
        if community_head and community_head != community_revision:
            message = "Community worktree HEAD differs from repos.lock.yaml revision."
            if not args.allow_community_head_mismatch:
                print(
                    f"ERROR: {message} Use --allow-community-head-mismatch only after review.",
                    file=sys.stderr,
                )
                return 4
            print(f"WARNING: {message}", file=sys.stderr)
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
