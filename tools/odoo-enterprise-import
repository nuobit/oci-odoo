"""Inspect an Odoo Enterprise source archive before importing it to Git.

This first implementation is intentionally dry-run only. It validates the
source archive against the exact Community source selected by repos.lock.yaml
and reports the modules that are not present in that Community source. Those are
Enterprise candidates until reviewed: an extra module can also mean the ZIP was
generated from a newer Community snapshot.

The import phase is deliberately separate from image builds:
- this tool handles ZIP acquisition/classification/import preparation;
- Dockerfile.source-build consumes only Git repositories pinned in
  repos.lock.yaml.
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import subprocess
import sys
import tempfile
import zipfile
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import yaml


IGNORED_DIRS = {".git", "__pycache__", ".mypy_cache", ".pytest_cache", ".ruff_cache"}
IGNORED_SUFFIXES = {".pyc", ".pyo"}
PROPRIETARY_LICENSES = {"OEEL-1", "OPL-1"}
PROPRIETARY_LICENSE_MARKERS = (
    "enterprise edition license",
    "proprietary",
)
VALID_REVIEW_CLASSIFICATIONS = {"enterprise", "community"}


@dataclass(frozen=True)
class ModuleInfo:
    name: str
    path: Path
    root: Path
    digest: str
    license: str | None


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha256_tree(path: Path) -> str:
    digest = hashlib.sha256()
    files: list[Path] = []
    for item in path.rglob("*"):
        if item.is_dir():
            continue
        rel = item.relative_to(path)
        if any(part in IGNORED_DIRS for part in rel.parts):
            continue
        if item.suffix in IGNORED_SUFFIXES:
            continue
        files.append(item)

    for item in sorted(files, key=lambda value: value.relative_to(path).as_posix()):
        rel = item.relative_to(path).as_posix()
        digest.update(rel.encode("utf-8"))
        digest.update(b"\0")
        digest.update(item.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


def load_yaml(path: Path) -> dict[str, Any]:
    data = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise SystemExit(f"{path}: expected a YAML mapping")
    return data


def parse_remote_ref(value: str, *, context: str) -> tuple[str, str]:
    parts = value.split(None, 1)
    if len(parts) != 2:
        raise SystemExit(f"{context}: expected '<remote> <ref>', got {value!r}")
    return parts[0], parts[1]


def locked_community_revision(lock_path: Path, community_dest: str) -> str:
    lock = load_yaml(lock_path)
    entry = lock.get(community_dest)
    if not isinstance(entry, dict):
        raise SystemExit(f"{lock_path}: missing community destination {community_dest!r}")
    merges = entry.get("merges")
    if not isinstance(merges, list) or len(merges) != 1:
        raise SystemExit(f"{lock_path}: {community_dest}: expected exactly one locked merge")
    merge = merges[0]
    if not isinstance(merge, str):
        raise SystemExit(f"{lock_path}: {community_dest}: expected string merge")
    _remote, revision = parse_remote_ref(merge, context=f"{community_dest}: merge")
    return revision


def git_head(path: Path) -> str | None:
    try:
        result = subprocess.run(
            ["git", "-C", str(path), "rev-parse", "HEAD"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None
    return result.stdout.strip()


def module_manifest_path(path: Path) -> Path | None:
    for filename in ("__manifest__.py", "__openerp__.py"):
        manifest_path = path / filename
        if manifest_path.is_file():
            return manifest_path
    return None


def is_module_dir(path: Path) -> bool:
    return module_manifest_path(path) is not None


def manifest_license(path: Path) -> str | None:
    manifest_path = module_manifest_path(path)
    if manifest_path is None:
        return None
    try:
        data = ast.literal_eval(manifest_path.read_text(encoding="utf-8"))
    except (OSError, SyntaxError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    license_value = data.get("license")
    if not isinstance(license_value, str):
        return None
    return license_value.strip() or None


def is_proprietary_license(license_value: str | None) -> bool:
    if license_value is None:
        return False
    normalized = license_value.strip()
    if normalized in PROPRIETARY_LICENSES:
        return True
    lowered = normalized.lower()
    return any(marker in lowered for marker in PROPRIETARY_LICENSE_MARKERS)


def source_root(path: Path) -> Path:
    """Return the likely source root from an extracted ZIP directory."""
    candidates = [path]
    children = [child for child in path.iterdir() if child.is_dir()] if path.is_dir() else []
    if len(children) == 1:
        candidates.append(children[0])

    for candidate in candidates:
        if (candidate / "odoo" / "addons").is_dir() or (candidate / "addons").is_dir():
            return candidate
    return path


def addon_roots(source: Path) -> list[Path]:
    candidates = [
        source / "odoo" / "addons",
        source / "addons",
        source,
    ]
    roots: list[Path] = []
    for candidate in candidates:
        if not candidate.is_dir():
            continue
        if candidate == source and not any(is_module_dir(child) for child in candidate.iterdir() if child.is_dir()):
            continue
        roots.append(candidate)
    return roots


def collect_modules(source: Path) -> dict[str, ModuleInfo]:
    modules: dict[str, ModuleInfo] = {}
    duplicate_names: dict[str, list[Path]] = {}

    for root in addon_roots(source):
        for child in sorted(root.iterdir()):
            if not child.is_dir() or child.name in IGNORED_DIRS:
                continue
            if not is_module_dir(child):
                continue
            digest = sha256_tree(child)
            if child.name in modules:
                duplicate_names.setdefault(child.name, [modules[child.name].path]).append(child)
                continue
            modules[child.name] = ModuleInfo(
                name=child.name,
                path=child,
                root=root,
                digest=digest,
                license=manifest_license(child),
            )

    if duplicate_names:
        details = "\n".join(
            f"  {name}: {', '.join(str(path) for path in paths)}"
            for name, paths in sorted(duplicate_names.items())
        )
        raise SystemExit(f"Duplicate module names found in {source}:\n{details}")
    return modules


def extract_zip(zip_path: Path, destination: Path) -> Path:
    with zipfile.ZipFile(zip_path) as archive:
        destination_resolved = destination.resolve()
        for member in archive.infolist():
            member_path = destination / member.filename
            try:
                member_path.resolve().relative_to(destination_resolved)
            except ValueError as exc:
                raise SystemExit(f"Unsafe ZIP member path: {member.filename!r}") from exc
        archive.extractall(destination)
    return source_root(destination)


def write_report(path: Path, report: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def load_review_decisions(path: Path | None) -> dict[str, dict[str, str | None]]:
    if path is None:
        return {}
    if not path.is_file():
        raise SystemExit(f"review decisions file not found: {path}")
    data = load_yaml(path)
    modules = data.get("modules", {})
    if not isinstance(modules, dict):
        raise SystemExit(f"{path}: expected 'modules' to be a mapping")

    decisions: dict[str, dict[str, str | None]] = {}
    for name, raw_decision in modules.items():
        if not isinstance(name, str) or not name:
            raise SystemExit(f"{path}: module names in 'modules' must be non-empty strings")

        classification = None
        reason = None
        if raw_decision is None:
            continue
        if isinstance(raw_decision, str):
            classification = raw_decision
        elif isinstance(raw_decision, dict):
            raw_classification = raw_decision.get("classification")
            if raw_classification is None or raw_classification == "":
                continue
            if not isinstance(raw_classification, str):
                raise SystemExit(f"{path}: {name}: classification must be a string")
            classification = raw_classification
            raw_reason = raw_decision.get("reason")
            if raw_reason is not None:
                reason = str(raw_reason)
        else:
            raise SystemExit(
                f"{path}: {name}: expected classification string or mapping with classification/reason"
            )

        normalized = classification.strip().lower()
        if normalized not in VALID_REVIEW_CLASSIFICATIONS:
            valid = ", ".join(sorted(VALID_REVIEW_CLASSIFICATIONS))
            raise SystemExit(f"{path}: {name}: classification must be one of: {valid}")
        decisions[name] = {"classification": normalized, "reason": reason}
    return decisions


def review_decision_for(
    name: str, decisions: dict[str, dict[str, str | None]]
) -> dict[str, str | None] | None:
    return decisions.get(name)


def write_review_template(path: Path, report: dict[str, Any]) -> None:
    details = report["candidate_enterprise_details"]
    review_modules = report["candidate_enterprise_review_modules"]
    removal_modules = report["import_plan"]["actions"]["remove"]
    path.parent.mkdir(parents=True, exist_ok=True)

    lines = [
        "# Odoo Enterprise import review decisions",
        "#",
        "# Fill only the modules you have reviewed. Classification values:",
        "#   enterprise: include this extra downloaded module in the Enterprise import plan",
        "#   community:  exclude this module from the Enterprise import plan",
        "#",
        "# If a future download proves a decision wrong, the dry-run will warn again.",
        "",
        "modules:",
    ]

    if review_modules:
        for name in review_modules:
            module_license = details[name]["license"] or "not declared"
            reason = json.dumps(f"review required; manifest license: {module_license}")
            lines.extend(
                [
                    f"  {name}:",
                    '    classification: ""  # enterprise|community',
                    f"    reason: {reason}",
                ]
            )
    else:
        lines[-1] = "modules: {}"

    if removal_modules:
        lines.extend(
            [
                "",
                "# Current-source modules planned as removals. These are listed for review,",
                "# but the current dry-run decision file only classifies downloaded candidate modules.",
                "# Review removals manually before any future apply mode.",
                "# removal_review_modules:",
            ]
        )
        for name in removal_modules:
            lines.append(f"#   - {name}")

    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def module_relative_path(module: ModuleInfo, source: Path) -> str:
    try:
        return module.path.relative_to(source).as_posix()
    except ValueError:
        return module.path.as_posix()


def build_import_plan(
    *,
    download_modules: dict[str, ModuleInfo],
    current_modules: dict[str, ModuleInfo],
    candidate_names: list[str],
    confirmed_names: list[str],
    review_names: list[str],
    download_root_path: Path,
    current_root_path: Path | None,
) -> dict[str, Any]:
    download_names = set(candidate_names)
    current_names = set(current_modules)
    add = sorted(download_names - current_names)
    common = sorted(download_names & current_names)
    update = sorted(name for name in common if download_modules[name].digest != current_modules[name].digest)
    unchanged = sorted(name for name in common if download_modules[name].digest == current_modules[name].digest)
    remove = sorted(current_names - download_names)
    confirmed_set = set(confirmed_names)
    review_set = set(review_names)

    action_details: dict[str, dict[str, Any]] = {}
    for name in add + update + unchanged:
        download_module = download_modules[name]
        current_module = current_modules.get(name)
        if name in confirmed_set:
            classification = "confirmed_enterprise"
        elif name in review_set:
            classification = "candidate_review"
        else:
            classification = "candidate"
        action = "add"
        if name in update:
            action = "update"
        elif name in unchanged:
            action = "unchanged"
        action_details[name] = {
            "action": action,
            "classification": classification,
            "download_digest": download_module.digest,
            "current_digest": current_module.digest if current_module else None,
            "download_license": download_module.license,
            "current_license": current_module.license if current_module else None,
            "download_relative_path": module_relative_path(download_module, download_root_path),
            "current_relative_path": (
                module_relative_path(current_module, current_root_path)
                if current_module and current_root_path
                else None
            ),
        }

    for name in remove:
        current_module = current_modules[name]
        action_details[name] = {
            "action": "remove",
            "classification": "current_only",
            "download_digest": None,
            "current_digest": current_module.digest,
            "download_license": None,
            "current_license": current_module.license,
            "download_relative_path": None,
            "current_relative_path": module_relative_path(current_module, current_root_path)
            if current_root_path
            else None,
        }

    review_required = sorted(set(review_names) | set(remove))
    return {
        "current_source": str(current_root_path) if current_root_path else None,
        "summary": {
            "add": len(add),
            "update": len(update),
            "remove": len(remove),
            "unchanged": len(unchanged),
            "review_required": len(review_required),
        },
        "actions": {
            "add": add,
            "update": update,
            "remove": remove,
            "unchanged": unchanged,
        },
        "confirmed_enterprise_actions": {
            "add": [name for name in add if name in confirmed_set],
            "update": [name for name in update if name in confirmed_set],
            "unchanged": [name for name in unchanged if name in confirmed_set],
        },
        "candidate_review_actions": {
            "add": [name for name in add if name in review_set],
            "update": [name for name in update if name in review_set],
            "unchanged": [name for name in unchanged if name in review_set],
        },
        "review_required_modules": review_required,
        "action_details": action_details,
    }


def build_human_summary(report: dict[str, Any]) -> dict[str, Any]:
    counts = report["counts"]
    plan = report["import_plan"]["summary"]
    review_modules = report["candidate_enterprise_review_modules"]
    removal_modules = report["import_plan"]["actions"]["remove"]
    decision_conflicts = report["review_decision_conflicts"]
    unused_decisions = report["unused_review_decisions"]
    warnings: list[str] = []
    if counts["missing_community_modules"]:
        warnings.append(
            f"{counts['missing_community_modules']} locked Community module(s) are missing from the download"
        )
    if counts["drifted_community_modules"]:
        warnings.append(
            f"{counts['drifted_community_modules']} matching Community module(s) drift byte-for-byte"
        )
    if counts["candidate_enterprise_review_modules"]:
        warnings.append(
            f"{counts['candidate_enterprise_review_modules']} candidate module(s) need manual review"
        )
    if plan["remove"]:
        warnings.append(f"{plan['remove']} current module(s) are planned as removal")
    if decision_conflicts:
        warnings.append(f"{len(decision_conflicts)} review decision(s) conflict with manifest evidence")
    if unused_decisions:
        warnings.append(f"{len(unused_decisions)} review decision(s) do not match current candidates")
    if report["community_worktree_head"] and report["community_worktree_head"] != report["community_lock_revision"]:
        warnings.append("Community checkout HEAD differs from repos.lock.yaml revision")

    return {
        "community_modules": counts["community_modules"],
        "download_modules": counts["download_modules"],
        "current_modules": counts["current_modules"],
        "confirmed_enterprise_modules": counts["confirmed_enterprise_modules"],
        "candidate_review_modules": counts["candidate_enterprise_review_modules"],
        "plan": {
            "add": plan["add"],
            "update": plan["update"],
            "remove": plan["remove"],
            "unchanged": plan["unchanged"],
            "review_required": plan["review_required"],
        },
        "review_candidate_modules": review_modules,
        "review_removal_modules": removal_modules,
        "review_decision_conflicts": decision_conflicts,
        "unused_review_decisions": unused_decisions,
        "warnings": warnings,
    }


def print_human_summary(summary: dict[str, Any]) -> None:
    plan = summary["plan"]
    print("Enterprise import dry-run summary")
    print("---------------------------------")
    print(f"Community modules:            {summary['community_modules']}")
    print(f"Downloaded modules:           {summary['download_modules']}")
    print(f"Current modules:              {summary['current_modules']}")
    print(f"Confirmed Enterprise modules: {summary['confirmed_enterprise_modules']}")
    print(f"Candidate modules to review:  {summary['candidate_review_modules']}")
    print(
        "Plan: add {add}, update {update}, remove {remove}, unchanged {unchanged}, review {review_required}".format(
            **plan
        )
    )
    if summary["warnings"]:
        print("Warnings:")
        for warning in summary["warnings"]:
            print(f"  - {warning}")
    else:
        print("Warnings: none")
    if summary["review_candidate_modules"]:
        print("Candidate modules needing review:")
        for name in summary["review_candidate_modules"]:
            print(f"  - {name}")
    if summary["review_removal_modules"]:
        print("Current modules planned as removal and needing review:")
        for name in summary["review_removal_modules"]:
            print(f"  - {name}")
    if summary["review_decision_conflicts"]:
        print("Review decision conflicts:")
        for conflict in summary["review_decision_conflicts"]:
            print(
                "  - {module}: decision={decision}, license={license}".format(
                    module=conflict["module"],
                    decision=conflict["decision"],
                    license=conflict["license"],
                )
            )
    if summary["unused_review_decisions"]:
        print("Unused review decisions:")
        for item in summary["unused_review_decisions"]:
            print(f"  - {item['module']}: decision={item['decision']}")
    print()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Dry-run an Odoo Enterprise ZIP/folder import against locked Community source.",
    )
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--zip", dest="zip_path", type=Path, help="Enterprise ZIP downloaded from Odoo")
    source.add_argument(
        "--download-src",
        type=Path,
        help="Already extracted Odoo Enterprise download root",
    )
    parser.add_argument("--community-src", type=Path, required=True, help="Local Odoo Community checkout/root")
    parser.add_argument(
        "--repos-lock",
        type=Path,
        required=True,
        help="repos.lock.yaml that contains the Community commit used by this deployment",
    )
    parser.add_argument(
        "--community-dest",
        default="./odoo",
        help="Destination key in repos.lock.yaml for Odoo Community (default: ./odoo)",
    )
    parser.add_argument("--report-json", type=Path, help="Write a machine-readable dry-run report")
    parser.add_argument(
        "--json-only",
        action="store_true",
        help="Print only JSON to stdout, without the human summary",
    )
    parser.add_argument(
        "--current-src",
        type=Path,
        help="Current private/internal source root to compare against for an add/update/remove plan",
    )
    parser.add_argument(
        "--allow-community-head-mismatch",
        action="store_true",
        help="Report but do not fail when Community checkout HEAD differs from repos.lock.yaml",
    )
    parser.add_argument(
        "--review-decisions",
        type=Path,
        help="YAML file with reviewed module classifications: enterprise or community",
    )
    parser.add_argument(
        "--write-review-template",
        type=Path,
        help="Write a YAML review-decisions template for unresolved modules",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    lock_path = args.repos_lock.resolve()
    community_src = source_root(args.community_src.resolve())

    if not lock_path.is_file():
        raise SystemExit(f"repos lock not found: {lock_path}")
    if not community_src.is_dir():
        raise SystemExit(f"community source not found: {community_src}")

    community_revision = locked_community_revision(lock_path, args.community_dest)
    community_head = git_head(community_src)
    review_decisions_path = args.review_decisions.resolve() if args.review_decisions else None
    review_decisions = load_review_decisions(review_decisions_path)
    current_src = None
    zip_sha256 = None
    zip_size = None

    if args.current_src:
        current_src = source_root(args.current_src.resolve())
        if not current_src.is_dir():
            raise SystemExit(f"current source not found: {current_src}")

    with tempfile.TemporaryDirectory(prefix="odoo-enterprise-import-") as tmp_name:
        if args.zip_path:
            zip_path = args.zip_path.resolve()
            if not zip_path.is_file():
                raise SystemExit(f"zip not found: {zip_path}")
            zip_sha256 = sha256_file(zip_path)
            zip_size = zip_path.stat().st_size
            download_src = extract_zip(zip_path, Path(tmp_name))
        else:
            download_src = source_root(args.download_src.resolve())

        if not download_src.is_dir():
            raise SystemExit(f"download source not found: {download_src}")

        community_modules = collect_modules(community_src)
        download_modules = collect_modules(download_src)
        if not community_modules:
            raise SystemExit(f"No Community modules found in {community_src}")
        if not download_modules:
            raise SystemExit(f"No downloaded modules found in {download_src}")

        community_names = set(community_modules)
        download_names = set(download_modules)
        missing_community = sorted(community_names - download_names)
        candidate_enterprise = sorted(download_names - community_names)
        matched_community = sorted(community_names & download_names)
        drifted_community = [
            name
            for name in matched_community
            if community_modules[name].digest != download_modules[name].digest
        ]
        candidate_details = {
            name: {
                "license": download_modules[name].license,
                "license_is_proprietary": is_proprietary_license(download_modules[name].license),
                "relative_path": download_modules[name].path.relative_to(download_src).as_posix(),
            }
            for name in candidate_enterprise
        }
        license_confirmed_enterprise = sorted(
            name for name, details in candidate_details.items() if details["license_is_proprietary"]
        )
        decision_enterprise = sorted(
            name
            for name in candidate_enterprise
            if review_decision_for(name, review_decisions)
            and review_decision_for(name, review_decisions)["classification"] == "enterprise"
        )
        decision_community = sorted(
            name
            for name in candidate_enterprise
            if review_decision_for(name, review_decisions)
            and review_decision_for(name, review_decisions)["classification"] == "community"
        )
        decision_conflicts = [
            {
                "module": name,
                "decision": "community",
                "license": download_modules[name].license,
                "reason": review_decisions[name]["reason"],
                "message": "decision marks module as community but the manifest license is proprietary",
            }
            for name in decision_community
            if is_proprietary_license(download_modules[name].license)
        ]
        unused_decisions = [
            {
                "module": name,
                "decision": decision["classification"],
                "reason": decision["reason"],
                "message": "decision did not match a current downloaded candidate module",
            }
            for name, decision in sorted(review_decisions.items())
            if name not in candidate_enterprise
        ]
        confirmed_enterprise = sorted(
            (set(license_confirmed_enterprise) | set(decision_enterprise)) - set(decision_community)
        )
        import_candidate_names = sorted(set(candidate_enterprise) - set(decision_community))
        review_candidates = sorted(set(import_candidate_names) - set(confirmed_enterprise))
        for name, details in candidate_details.items():
            decision = review_decision_for(name, review_decisions)
            details["review_decision"] = decision["classification"] if decision else None
            details["review_decision_reason"] = decision["reason"] if decision else None
            if name in decision_community:
                details["effective_classification"] = "decision_community"
            elif name in license_confirmed_enterprise:
                details["effective_classification"] = "confirmed_enterprise_license"
            elif name in decision_enterprise:
                details["effective_classification"] = "confirmed_enterprise_decision"
            else:
                details["effective_classification"] = "needs_review"
        current_modules = collect_modules(current_src) if current_src else {}
        import_plan = build_import_plan(
            download_modules=download_modules,
            current_modules=current_modules,
            candidate_names=import_candidate_names,
            confirmed_names=confirmed_enterprise,
            review_names=review_candidates,
            download_root_path=download_src,
            current_root_path=current_src,
        )
        recommendations: list[str] = []
        if missing_community:
            recommendations.extend(
                [
                    "Ensure the Enterprise ZIP was freshly downloaded.",
                    "Run lock-repos --refresh ./odoo if the local Community lock may be stale, then retry.",
                    "Ensure --community-src was materialized from the same repos.lock.yaml being checked.",
                ]
            )
        if drifted_community:
            recommendations.extend(
                [
                    "Review drifted Community modules before importing.",
                    "If the ZIP was generated from a newer Community snapshot, refresh the Community lock and retry.",
                ]
            )
        if candidate_enterprise:
            recommendations.append(
                "Review candidate Enterprise modules; if any are actually newer Community modules, refresh Community and retry."
            )
        if decision_community:
            recommendations.append(
                "Modules explicitly decided as community are excluded from the Enterprise import plan."
            )
        if confirmed_enterprise:
            recommendations.append(
                "Modules with a proprietary manifest license can be treated as confirmed Enterprise import modules."
            )
        if decision_enterprise:
            recommendations.append(
                "Modules explicitly decided as enterprise are included in the Enterprise import plan."
            )
        if review_candidates:
            recommendations.append(
                "Candidate modules without a proprietary manifest license or review decision need manual review before import."
            )
        if decision_conflicts:
            recommendations.append(
                "Review decisions that conflict with proprietary manifest licenses should be corrected before apply."
            )
        if unused_decisions:
            recommendations.append(
                "Unused review decisions may be stale after a Community refresh or a later Enterprise download."
            )
        if import_plan["actions"]["remove"]:
            recommendations.append(
                "Current Enterprise-only modules are planned as removals, but each removal needs review before apply."
            )

        report = {
            "generated_at": datetime.now(timezone.utc).isoformat(),
            "mode": "dry-run",
            "zip_sha256": zip_sha256,
            "zip_size": zip_size,
            "download_source": str(download_src),
            "current_source": str(current_src) if current_src else None,
            "community_source": str(community_src),
            "community_dest": args.community_dest,
            "community_lock_revision": community_revision,
            "community_worktree_head": community_head,
            "review_decisions_source": str(review_decisions_path) if review_decisions_path else None,
            "counts": {
                "community_modules": len(community_modules),
                "download_modules": len(download_modules),
                "matched_community_modules": len(matched_community),
                "missing_community_modules": len(missing_community),
                "drifted_community_modules": len(drifted_community),
                "candidate_enterprise_modules": len(candidate_enterprise),
                "import_candidate_modules": len(import_candidate_names),
                "license_confirmed_enterprise_modules": len(license_confirmed_enterprise),
                "confirmed_enterprise_modules": len(confirmed_enterprise),
                "candidate_enterprise_review_modules": len(review_candidates),
                "decision_enterprise_modules": len(decision_enterprise),
                "decision_community_modules": len(decision_community),
                "unused_review_decisions": len(unused_decisions),
                "review_decision_conflicts": len(decision_conflicts),
                "current_modules": len(current_modules),
            },
            "missing_community_modules": missing_community,
            "drifted_community_modules": sorted(drifted_community),
            "candidate_enterprise_modules": candidate_enterprise,
            "import_candidate_modules": import_candidate_names,
            "license_confirmed_enterprise_modules": license_confirmed_enterprise,
            "confirmed_enterprise_modules": confirmed_enterprise,
            "candidate_enterprise_review_modules": review_candidates,
            "decision_enterprise_modules": decision_enterprise,
            "decision_community_modules": decision_community,
            "unused_review_decisions": unused_decisions,
            "review_decision_conflicts": decision_conflicts,
            "candidate_enterprise_details": candidate_details,
            "import_plan": import_plan,
            "recommendations": recommendations,
        }
        report["human_summary"] = build_human_summary(report)

        if args.report_json:
            write_report(args.report_json, report)
        if args.write_review_template:
            write_review_template(args.write_review_template, report)

        if not args.json_only:
            print_human_summary(report["human_summary"])
        print(json.dumps(report, indent=2, sort_keys=True))

        if missing_community:
            print(
                "ERROR: Enterprise download is not an exhaustive superset of the locked Community source. "
                "Refresh the Enterprise ZIP and/or run lock-repos --refresh ./odoo, then retry.",
                file=sys.stderr,
            )
            return 2
        if drifted_community:
            print(
                "WARNING: Matching Community modules differ from the locked Community source. "
                "Review before importing; this may mean the ZIP and Community lock are from different snapshots.",
                file=sys.stderr,
            )
        if community_head and community_head != community_revision:
            message = "Community worktree HEAD differs from repos.lock.yaml revision."
            if not args.allow_community_head_mismatch:
                print(
                    f"ERROR: {message} Use --allow-community-head-mismatch only after review.",
                    file=sys.stderr,
                )
                return 4
            print(f"WARNING: {message}", file=sys.stderr)
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
