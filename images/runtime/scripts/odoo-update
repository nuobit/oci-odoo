#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 NuoBiT Solutions, S.L.
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

if [[ $# -lt 2 ]]; then
    echo "Usage: odoo-update <database> <modules|all> [extra odoo args...]" >&2
    exit 2
fi

database="$1"
modules="$2"
shift 2

exec odoo-run -d "${database}" -u "${modules}" --stop-after-init "$@"
