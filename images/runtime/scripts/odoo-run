#!/usr/bin/env bash
set -euo pipefail

odoo_bin="${ODOO_BIN:-/opt/odoo/src/odoo/odoo-bin}"
venv_python="${ODOO_VENV:-/opt/odoo/venv}/bin/python"
python_bin="${ODOO_RUN_PYTHON:-${venv_python}}"
runtime_rc="${ODOO_RUNTIME_RC:-/run/odoo/odoo-runtime.conf}"
config_file="${ODOO_CONFIG_FILE:-${ODOO_RC:-}}"
base_config_file="${ODOO_BASE_CONFIG_FILE:-}"
default_addons_path_file="${ODOO_ADDONS_PATH_FILE:-/etc/odoo/addons_path}"

if [[ ! -f "${odoo_bin}" ]]; then
    echo "Odoo binary not found at ${odoo_bin}" >&2
    echo "This base image is not deployable by itself; a deployment image must add Odoo source." >&2
    exit 127
fi

if [[ ! -x "${python_bin}" ]]; then
    python_bin="${ODOO_PYTHON:-}"
fi

if [[ ! -x "${python_bin}" ]]; then
    python_bin="$(command -v python3 || true)"
fi

if [[ -z "${python_bin}" ]]; then
    echo "Python interpreter not found" >&2
    exit 127
fi

read_env_or_file() {
    local name="$1"
    local file_name="${name}_FILE"
    local value="${!name:-}"
    local file_value="${!file_name:-}"

    if [[ -n "${value}" && -n "${file_value}" ]]; then
        echo "Set either ${name} or ${file_name}, not both" >&2
        exit 2
    fi

    if [[ -n "${file_value}" ]]; then
        if [[ ! -f "${file_value}" ]]; then
            echo "Secret file not found for ${file_name}: ${file_value}" >&2
            exit 2
        fi
        tr -d '\r\n' < "${file_value}"
        return
    fi

    printf '%s' "${value}"
}

read_addons_path() {
    if [[ -n "${ODOO_ADDONS_PATH:-}" || -n "${ODOO_ADDONS_PATH_FILE:-}" ]]; then
        read_env_or_file ODOO_ADDONS_PATH
        return
    fi

    if [[ -f "${default_addons_path_file}" ]]; then
        tr -d '\r\n' < "${default_addons_path_file}"
    fi
}

runtime_options_file=""

cleanup_runtime_options_file() {
    if [[ -n "${runtime_options_file}" && -f "${runtime_options_file}" ]]; then
        rm -f "${runtime_options_file}"
    fi
}

trap cleanup_runtime_options_file EXIT

append_option() {
    local key="$1"
    local value="$2"

    if [[ -n "${value}" ]]; then
        printf '%s=%s\n' "${key}" "${value}" >> "${runtime_options_file}"
    fi
}

append_env_option() {
    local key="$1"
    local env_name="$2"

    append_option "${key}" "${!env_name:-}"
}

render_runtime_config() {
    local base_file="$1"
    local options_file="$2"
    local output_file="$3"

    "${python_bin}" - "${base_file}" "${options_file}" "${output_file}" <<'PY'
from __future__ import annotations

import os
import re
import sys
from pathlib import Path


base_file_arg, options_file_arg, output_file_arg = sys.argv[1:4]
base_file = Path(base_file_arg) if base_file_arg else None
options_file = Path(options_file_arg)
output_file = Path(output_file_arg)

forbidden_base_options = {"addons_path", "db_password", "admin_passwd"}
generated: list[tuple[str, str]] = []

if options_file.exists():
    for raw_line in options_file.read_text(encoding="utf-8").splitlines():
        if not raw_line:
            continue
        key, value = raw_line.split("=", 1)
        generated.append((key.strip(), value))

generated_keys = {key.lower() for key, _value in generated}
lines: list[str] = []

if base_file:
    if not base_file.is_file():
        print(f"Base Odoo config file not found: {base_file}", file=sys.stderr)
        raise SystemExit(2)
    lines = base_file.read_text(encoding="utf-8").splitlines()

section_re = re.compile(r"^\s*\[([^\]]+)\]\s*(?:[;#].*)?$")
option_re = re.compile(r"^(\s*)([A-Za-z0-9_]+)(\s*=\s*)(.*)$")

output: list[str] = []
current_section: str | None = None
options_started = False
options_inserted = False
options_found = False


def generated_block() -> list[str]:
    if not generated:
        return []
    return [
        "; Runtime values generated by odoo-run.",
        "; Do not store secrets in the deployment base config.",
        *[f"{key} = {value}" for key, value in generated],
    ]


for line in lines:
    section_match = section_re.match(line)
    if section_match:
        if options_started and not options_inserted:
            output.extend(generated_block())
            options_inserted = True
        current_section = section_match.group(1).strip().lower()
        options_started = current_section == "options"
        options_found = options_found or options_started
        output.append(line)
        continue

    if current_section == "options":
        option_match = option_re.match(line)
        if option_match:
            key = option_match.group(2).strip().lower()
            if key in forbidden_base_options:
                print(
                    f"Forbidden option in base Odoo config: {key}. "
                    "Use Secret files or the generated image addons_path instead.",
                    file=sys.stderr,
                )
                raise SystemExit(2)
            if key in generated_keys:
                continue

    output.append(line)

if options_found:
    if not options_inserted:
        output.extend(generated_block())
else:
    output = [
        "[options]",
        "; Runtime values generated by odoo-run.",
        "; Do not bake secrets into the image.",
        *[f"{key} = {value}" for key, value in generated],
        "",
        *output,
    ]

output_file.parent.mkdir(parents=True, exist_ok=True)
output_file.write_text("\n".join(output).rstrip() + "\n", encoding="utf-8")
os.chmod(output_file, 0o600)
PY
}

if [[ -n "${base_config_file}" && ! -f "${base_config_file}" ]]; then
    echo "Base Odoo config file not found: ${base_config_file}" >&2
    exit 2
fi

needs_runtime_config=0
for env_name in \
    ODOO_BASE_CONFIG_FILE \
    ODOO_DB_HOST \
    ODOO_DB_PORT \
    ODOO_DB_USER \
    ODOO_DB_PASSWORD \
    ODOO_DB_PASSWORD_FILE \
    ODOO_DB_NAME \
    ODOO_DBFILTER \
    ODOO_ADMIN_PASSWD \
    ODOO_ADMIN_PASSWD_FILE \
    ODOO_ADDONS_PATH \
    ODOO_ADDONS_PATH_FILE \
    ODOO_DATA_DIR \
    ODOO_PROXY_MODE \
    ODOO_LIST_DB \
    ODOO_WORKERS \
    ODOO_MAX_CRON_THREADS \
    ODOO_HTTP_PORT \
    ODOO_GEVENT_PORT; do
    if [[ -n "${!env_name:-}" ]]; then
        needs_runtime_config=1
        break
    fi
done

if [[ "${needs_runtime_config}" == "0" && -f "${default_addons_path_file}" ]]; then
    needs_runtime_config=1
fi

if [[ "${ODOO_GENERATE_CONFIG:-auto}" == "1" || "${needs_runtime_config}" == "1" ]]; then
    mkdir -p /run/odoo
    chmod 0700 /run/odoo
    runtime_options_file="$(mktemp /run/odoo/odoo-runtime-options.XXXXXX)"
    chmod 0600 "${runtime_options_file}"

    append_env_option db_host ODOO_DB_HOST
    append_env_option db_port ODOO_DB_PORT
    append_env_option db_user ODOO_DB_USER
    append_option db_password "$(read_env_or_file ODOO_DB_PASSWORD)"
    append_env_option db_name ODOO_DB_NAME
    append_env_option dbfilter ODOO_DBFILTER
    append_option admin_passwd "$(read_env_or_file ODOO_ADMIN_PASSWD)"
    append_option addons_path "$(read_addons_path)"
    append_env_option data_dir ODOO_DATA_DIR
    append_env_option proxy_mode ODOO_PROXY_MODE
    append_env_option list_db ODOO_LIST_DB
    append_env_option workers ODOO_WORKERS
    append_env_option max_cron_threads ODOO_MAX_CRON_THREADS
    append_env_option http_port ODOO_HTTP_PORT
    append_env_option gevent_port ODOO_GEVENT_PORT

    render_runtime_config "${base_config_file}" "${runtime_options_file}" "${runtime_rc}"
    cleanup_runtime_options_file

    exec "${python_bin}" "${odoo_bin}" -c "${runtime_rc}" "$@"
fi

if [[ -n "${config_file}" && -f "${config_file}" ]]; then
    exec "${python_bin}" "${odoo_bin}" -c "${config_file}" "$@"
fi

exec "${python_bin}" "${odoo_bin}" "$@"
