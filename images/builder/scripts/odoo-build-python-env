#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 NuoBiT Solutions, S.L.
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

if [[ $# -lt 3 ]]; then
    echo "Usage: odoo-build-python-env <odoo-requirements.txt> <requirements.lock.txt> <venv-dir> [--requirement requirements.in ...] [--constraint requirements-constraints.in ...] [--overrides requirements-overrides.in] [--refresh-requirements-lock]" >&2
    exit 2
fi

odoo_requirements="$(realpath "$1")"
requirements_lock="$(realpath -m "$2")"
odoo_venv="$(realpath -m "$3")"
shift 3

extra_requirements=()
constraints=()
overrides=""
refresh_requirements_lock=0
target_python="${ODOO_PYTHON:-$(command -v python3)}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--requirement)
            if [[ $# -lt 2 ]]; then
                echo "$1 requires a file argument" >&2
                exit 2
            fi
            extra_requirements+=("$(realpath "$2")")
            shift 2
            ;;
        -c|--constraint)
            if [[ $# -lt 2 ]]; then
                echo "$1 requires a file argument" >&2
                exit 2
            fi
            constraints+=("$(realpath "$2")")
            shift 2
            ;;
        --overrides)
            if [[ $# -lt 2 ]]; then
                echo "$1 requires a file argument" >&2
                exit 2
            fi
            overrides="$(realpath "$2")"
            shift 2
            ;;
        --refresh-requirements-lock)
            refresh_requirements_lock=1
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
    esac
done

if [[ ! -f "${odoo_requirements}" ]]; then
    echo "Odoo requirements file not found: ${odoo_requirements}" >&2
    exit 2
fi

if [[ ! -x "${target_python}" ]]; then
    echo "Target Python interpreter not found or not executable: ${target_python}" >&2
    exit 2
fi

read -r python_version python_full_version sys_platform os_name platform_system < <(
    "${target_python}" - <<'PY'
from __future__ import annotations

import os
import platform
import sys

print(
    f"{sys.version_info.major}.{sys.version_info.minor}",
    ".".join(str(part) for part in sys.version_info[:3]),
    sys.platform,
    os.name,
    platform.system(),
)
PY
)

for file in "${extra_requirements[@]}" "${constraints[@]}"; do
    if [[ ! -f "${file}" ]]; then
        echo "Requirements input file not found: ${file}" >&2
        exit 2
    fi
done

if [[ -n "${overrides}" && ! -f "${overrides}" ]]; then
    echo "Requirements overrides input not found: ${overrides}" >&2
    exit 2
fi

lock_has_payload() {
    [[ -f "$1" ]] && sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$1" | grep -q .
}

if [[ "${refresh_requirements_lock}" -eq 1 || ! -f "${requirements_lock}" ]]; then
    work_dir="$(mktemp -d)"
    cleanup() {
        rm -rf "${work_dir}"
    }
    trap cleanup EXIT

    combined_requirements="${work_dir}/requirements.combined.in"
    effective_requirements="${work_dir}/requirements.effective.in"
    normalization_report="${work_dir}/requirements.normalized.report.md"
    empty_overrides="${work_dir}/requirements-overrides.empty.in"

    {
        echo "-r ${odoo_requirements}"
        for requirement in "${extra_requirements[@]}"; do
            echo "-r ${requirement}"
        done
    } > "${combined_requirements}"

    if [[ -z "${overrides}" ]]; then
        : > "${empty_overrides}"
        overrides="${empty_overrides}"
    fi

    odoo-normalize-requirements \
        --requirements "${combined_requirements}" \
        --overrides "${overrides}" \
        --output "${effective_requirements}" \
        --report "${normalization_report}" \
        --python-version "${python_version}" \
        --python-full-version "${python_full_version}" \
        --sys-platform "${sys_platform}" \
        --os-name "${os_name}" \
        --platform-system "${platform_system}"

    constraint_args=()
    for constraint in "${constraints[@]}"; do
        constraint_args+=(--constraint "${constraint}")
    done

    tmp_lock="${work_dir}/requirements.lock.txt"
    pip-compile \
        --resolver=backtracking \
        --allow-unsafe \
        --strip-extras \
        --no-annotate \
        --no-header \
        --output-file "${tmp_lock}" \
        "${constraint_args[@]}" \
        "${effective_requirements}"

    mkdir -p "$(dirname "${requirements_lock}")"
    {
        echo "# Generated by oci-odoo-builder odoo-build-image. Do not edit manually."
        echo "# Edit requirements.in, requirements-constraints.in, or requirements-overrides.in, then refresh deliberately."
        echo "# Source repositories are pinned separately by repos.lock.yaml."
        echo "# Python resolver runtime: Python ${python_version}"
        echo
        cat "${tmp_lock}"
    } > "${requirements_lock}"
elif ! lock_has_payload "${requirements_lock}"; then
    echo "Python requirements lock is empty: ${requirements_lock}" >&2
    echo "Build once with --refresh-requirements-lock, extract the generated lock, and commit it." >&2
    exit 2
else
    echo "Using existing requirements lock without refresh: ${requirements_lock}"
fi

"${target_python}" -m venv --clear "${odoo_venv}"
"${odoo_venv}/bin/python" -m pip install --no-cache-dir -r "${requirements_lock}"
"${odoo_venv}/bin/python" -m pip check
